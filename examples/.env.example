# Copy this file to `.env` and fill in your real credentials.
# You can find these in the Monime Dashboard: https://monime.io

# Space IDs are prefixed `spc-`.
MONIME_SPACE_ID=spc-XXXXXXXX

# The token picks the environment: `mon_test_` = sandbox, `mon_` = live.
MONIME_ACCESS_TOKEN=mon_test_XXXXXXXX

# Optional — defaults to the latest supported version if omitted.
# MONIME_VERSION=caph.2025-08-23
